# Server-only connection to the Property Hunter API.
# Never expose these values through NEXT_PUBLIC_* variables.
MPH_API_URL=https://your-project.functions.supabase.co/property-hunter-api
MPH_API_TOKEN=replace-with-a-long-random-token

# Supabase Edge Function secrets (configure in Supabase, not in this file).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-supabase-secrets
MPH_TOKEN_HASH=sha256-of-mph-api-token
